{
  "name": "hydro-js",
  "version": "1.10.3",
  "description": "A lightweight reactive library",
  "type": "module",
  "main": "./dist/library.js",
  "module": "./dist/library.js",
  "types": "./dist/library.d.ts",
  "exports": {
    ".": {
      "types": "./dist/library.d.ts",
      "default": "./dist/library.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "default": "./dist/jsx-dev-runtime.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "concurrently \"serve dist\" \"tsc -w\"",
    "test": "npm run test:dom && npm run test:browser",
    "test:dom": "tsc && node dist/testHAPPYDOM.js && node dist/testJSDOM.js",
    "test:browser": "tsc && wtr src/test.html --node-resolve --coverage --playwright --browsers chromium firefox webkit",
    "bench": "npm run bench:mem && npm run bench:perf:browser:node && npm run bench:size",
    "bench:mem": "tsc && node dist/benchmark.browser.node.js",
    "bench:perf:browser:node": "tsc && node dist/benchmark.perf.browser.node.js",
    "bench:perf:browser:baseline": "tsc && node dist/benchmark.perf.browser.node.js --write-baseline perf-baseline.browser.json",
    "bench:perf:browser:check": "tsc && node dist/benchmark.perf.browser.node.js --baseline perf-baseline.browser.json",
    "bench:size": "tsc && node dist/benchmark.size.node.js"
  },
  "keywords": [
    "reactive",
    "library",
    "javascript",
    "dom",
    "modern",
    "fast",
    "ssr"
  ],
  "author": "Fabian Klingenberg <klingenberg.fabian@gmx.de> (https://klingenberg.works/)",
  "license": "MIT",
  "devDependencies": {
    "@esm-bundle/chai": "^4.3.4",
    "@types/jsdom": "^30.0.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-playwright": "^1.0.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "playwright-core": "^1.65.0",
    "serve": "^14.2.7",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krutsch/hydro-js.git"
  },
  "bugs": "https://github.com/Krutsch/hydro-js/issues",
  "allowScripts": {
    "esbuild": true
  }
}
